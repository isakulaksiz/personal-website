---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import type { Lang } from '../../i18n/ui';
import { langPaths, localePath, useTranslations } from '../../i18n/utils';
import { profile } from '../../data/profile';
import { publications, formatVenue } from '../../data/publications';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const selected = publications.filter((p) => p.selected).sort((a, b) => b.year - a.year);
---
<BaseLayout lang={lang} path="" title={t('site.title')} description={profile.bio[lang]}>
  <section class="section">
    <h1>{profile.name}</h1>
    <p class="muted">
      {profile.role[lang]} · <a href={profile.affiliation.url}>{profile.affiliation.name}</a> · {profile.location[lang]}
    </p>
    <p>{profile.bio[lang]}</p>
    <p><a href={localePath(lang, 'about')}>{t('home.more')}</a></p>
  </section>

  {
    selected.length > 0 && (
      <section class="section">
        <h2>{t('home.publications')}</h2>
        <ul class="item-list">
          {selected.map((p) => (
            <li>
              <a class="item-title" href={`${localePath(lang, 'research')}#${p.id}`}>{p.title}</a>
              <p class="meta">{formatVenue(p)}, {p.year}</p>
            </li>
          ))}
        </ul>
        <p><a href={localePath(lang, 'research')}>{t('home.allPublications')}</a></p>
      </section>
    )
  }

  <section class="section">
    <h2>{t('home.links')}</h2>
    <SocialLinks lang={lang} />
  </section>
</BaseLayout>
