---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Lang } from '../../../i18n/ui';
import { formatDate, langPaths, localePath, useTranslations } from '../../../i18n/utils';
import { getPosts, postSlug } from '../../../lib/blog';
import { getMediumPosts } from '../../../lib/medium';
import { profile } from '../../../data/profile';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const mediumPosts = await getMediumPosts();
const posts = await getPosts(lang);
const mediumProfile = profile.links.find((l) => l.key === 'medium')?.url ?? 'https://medium.com/@isakulaksiz.ce';
---
<BaseLayout lang={lang} path="blog" title={t('blog.title')} description={t('blog.intro')}>
  <h1>{t('blog.title')}</h1>
  <p class="muted">{t('blog.intro')}</p>

  <section class="section">
    <h2>{t('blog.medium')}</h2>
    {mediumPosts.length === 0 && <p>{t('blog.empty')}</p>}
    <ul class="item-list">
      {
        mediumPosts.map((post) => (
          <li>
            <p class="meta">
              <time datetime={post.date}>{formatDate(new Date(post.date), lang)}</time> · Medium
            </p>
            <a class="item-title" href={post.url} rel="noopener" target="_blank">{post.title}</a>
            {post.excerpt && <p>{post.excerpt}</p>}
            {post.tags.length > 0 && (
              <div class="tags">
                {post.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <p><a href={mediumProfile} rel="me noopener" target="_blank">{t('blog.mediumProfile')}</a></p>
  </section>

  <section class="section">
    <h2>{t('blog.notes')}</h2>
    {posts.length === 0 && <p>{t('blog.empty')}</p>}
    <ul class="item-list">
      {
        posts.map((post) => (
          <li>
            <p class="meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
            </p>
            <a class="item-title" href={localePath(lang, `blog/${postSlug(post)}`)}>{post.data.title}</a>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>{t('blog.archive')}</h2>
    <ul class="item-list">
      <li>
        <a class="item-title" href={profile.cExamples.url} rel="me noopener" target="_blank">{profile.cExamples.label[lang]}</a>
        <p>{t('blog.cexamplesText')}</p>
        <div class="tags">
          <span class="tag">{t('blog.undergrad')}</span>
          <span class="tag">C</span>
          <span class="tag">Blogspot</span>
        </div>
      </li>
    </ul>
  </section>
</BaseLayout>
