---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/ui';
import { langPaths, useTranslations } from '../../i18n/utils';
import { profile } from '../../data/profile';
import { publications, researchIntro, formatAuthors, formatVenue, toBibtex } from '../../data/publications';
import { resources } from '../../data/resources';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const sorted = [...publications].sort((a, b) => b.year - a.year);
const academicProfiles = profile.links.filter((l) => ['scholar', 'orcid', 'researchgate', 'dergipark', 'huggingface'].includes(l.key));
const typeLabel = (type: string) => t(`research.type.${type}` as Parameters<typeof t>[0]);
---
<BaseLayout lang={lang} path="research" title={t('research.title')} description={researchIntro[lang]}>
  <h1>{t('research.title')}</h1>
  <p>{researchIntro[lang]}</p>
  <p class="small muted">
    {t('research.profiles')}
    {academicProfiles.map((l, i) => (
      <>
        {i > 0 ? ' · ' : ' '}<a href={l.url} rel="me noopener" target="_blank">{typeof l.label === 'string' ? l.label : l.label[lang]}</a>
      </>
    ))}
  </p>

  <section class="section">
    <h2>{t('research.publications')}</h2>
    <ul class="item-list">
      {
        sorted.map((p) => (
          <li id={p.id}>
            <p class="meta">{p.year} · {typeLabel(p.type)}</p>
            {p.doi || p.url ? (
              <a class="item-title" href={p.doi ? `https://doi.org/${p.doi}` : p.url}>{p.title}</a>
            ) : (
              <span class="item-title">{p.title}</span>
            )}
            <p class="meta" set:html={formatAuthors(p.authors).replace(profile.name, `<strong>${profile.name}</strong>`)} />
            <p class="meta"><em>{formatVenue(p)}</em></p>
            {p.note && <p class="meta">{p.note[lang]}</p>}
            {p.doi && (
              <p class="meta">
                DOI: <a href={`https://doi.org/${p.doi}`}>{p.doi}</a>
              </p>
            )}
            <div class="tags">
              {p.keywords[lang].map((k) => <span class="tag">{k}</span>)}
            </div>
            <details>
              <summary>{t('research.summary')}</summary>
              <p>{p.summary[lang]}</p>
            </details>
            <details>
              <summary>BibTeX</summary>
              <pre><code>{toBibtex(p)}</code></pre>
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>{t('research.resources')}</h2>
    <p class="muted">{t('research.resourcesIntro')}</p>
    <ul class="item-list">
      {
        resources.map((r) => (
          <li>
            <p class="meta">{t(`research.kind.${r.kind}` as Parameters<typeof t>[0])}</p>
            <a class="item-title" href={r.url} rel="noopener" target="_blank">{r.name}</a>
            <p class="meta"><code>{r.id}</code></p>
            <p>{r.description[lang]}</p>
            <div class="tags">
              {r.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
