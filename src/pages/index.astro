---
// Kök adres: tarayıcı diline göre /tr/ veya /en/ sayfasına yönlendirir.
import { localePath } from '../i18n/utils';

const tr = localePath('tr');
const en = localePath('en');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>İsa Kulaksız</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="tr" href={new URL(tr, Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(en, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(tr, Astro.site).toString()} />
    <script define:vars={{ tr, en }}>
      const langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'tr'];
      const prefersTurkish = langs.some((l) => String(l).toLowerCase().startsWith('tr'));
      location.replace(prefersTurkish ? tr : en);
    </script>
    <meta http-equiv="refresh" content={`0; url=${tr}`} />
  </head>
  <body>
    <p><a href={tr}>Türkçe</a> · <a href={en}>English</a></p>
  </body>
</html>
