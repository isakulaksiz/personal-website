---
import { languages, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
---
<nav class="lang-switch" aria-label={t('lang.label')}>
  {
    (Object.entries(languages) as [Lang, string][]).map(([code, label]) =>
      code === lang ? (
        <span aria-current="true" lang={code} title={label}>{code.toUpperCase()}</span>
      ) : (
        <a href={alternates[code]} lang={code} hreflang={code} title={label}>{code.toUpperCase()}</a>
      ),
    )
  }
</nav>
